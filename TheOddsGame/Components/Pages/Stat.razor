@page "/stat"
@rendermode InteractiveServer

@using OddsViewerApp.Models
@using OddsViewerApp.Services

@inject BoxScoreService BoxScores
@inject IDialogService DialogService

<PageTitle>Game Results</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">

    <MudText Typo="Typo.h5" Class="mb-1">Game Results</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">
        Most recent games first. Click a game to view its box score.
    </MudText>

    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudTextField T="string"
                      Value="_teamSearch"
                      ValueChanged="OnTeamSearchChanged"
                      Label="Search team"
                      Placeholder="e.g. Celtics, Boston, Lakers..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="400"
                      Clearable="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense" />
    </MudPaper>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
    }

    <MudTable Items="_games"
              T="GameSummary"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm"
              OnRowClick="OnRowClick"
              RowStyle="cursor: pointer;"
              Elevation="1">
        <HeaderContent>
            <MudTh>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                    <span>Game Date</span>
                    <MudIconButton Icon="@(_dateFilter.HasValue ? Icons.Material.Filled.FilterAlt : Icons.Material.Outlined.FilterAlt)"
                                   Color="@(_dateFilter.HasValue ? Color.Primary : Color.Default)"
                                   Size="Size.Small"
                                   OnClick="ToggleDateFilter"
                                   aria-label="Show games starting at a date" />
                    <MudPopover Open="_dateFilterOpen"
                                AnchorOrigin="Origin.BottomLeft"
                                TransformOrigin="Origin.TopLeft"
                                Fixed="true"
                                Paper="true"
                                Class="pa-2">
                        <MudStack Spacing="1">
                            <MudDatePicker Date="_dateFilter"
                                           DateChanged="OnDateFilterChanged"
                                           PickerVariant="PickerVariant.Static" />
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudButton Size="Size.Small" OnClick="ClearDateFilter" Disabled="@(!_dateFilter.HasValue)">Clear</MudButton>
                                <MudButton Size="Size.Small" OnClick="ToggleDateFilter">Close</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPopover>
                </MudStack>
            </MudTh>
            <MudTh>Home</MudTh>
            <MudTh>Away</MudTh>
            <MudTh Style="text-align:right;">Score (Away - Home)</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Game Date">@context.GameDate.ToString("MMM d, yyyy")</MudTd>
            <MudTd DataLabel="Home">@context.HomeTeam</MudTd>
            <MudTd DataLabel="Away">@context.AwayTeam</MudTd>
            <MudTd DataLabel="Score" Style="text-align:right;">@context.Score</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4">@(_isLoading ? "Loading games..." : "No games found.")</MudText>
        </NoRecordsContent>
    </MudTable>

    <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-3" Spacing="2">
        <MudButton Variant="Variant.Outlined" Disabled="@(_page == 0 || _isLoading)" OnClick="PreviousPage">Previous</MudButton>
        <MudText Typo="Typo.body2">Page @(_page + 1)</MudText>
        <MudButton Variant="Variant.Outlined" Disabled="@(!_hasMore || _isLoading)" OnClick="NextPage">Next</MudButton>
    </MudStack>

</MudContainer>

@code {
    private const int PageSize = 25;

    private List<GameSummary> _games = new();
    private string? _teamSearch;
    private DateTime? _dateFilter;
    private bool _dateFilterOpen;
    private bool _isLoading;
    private bool _hasMore;
    private int _page;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadGamesAsync();

    private async Task LoadGamesAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            // Fetch one extra row to know whether a next page exists.
            var rows = await BoxScores.GetRecentGamesAsync(_teamSearch, _dateFilter, PageSize + 1, _page * PageSize);
            _hasMore = rows.Count > PageSize;
            _games = rows.Take(PageSize).ToList();
        }
        catch (Exception ex)
        {
            _error = $"Could not load games: {ex.Message}";
            _games = new();
            _hasMore = false;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnTeamSearchChanged(string? value)
    {
        _teamSearch = value;
        _page = 0;
        await LoadGamesAsync();
    }

    private void ToggleDateFilter() => _dateFilterOpen = !_dateFilterOpen;

    private async Task OnDateFilterChanged(DateTime? date)
    {
        _dateFilter = date;
        _dateFilterOpen = false;
        _page = 0;
        await LoadGamesAsync();
    }

    private async Task ClearDateFilter() => await OnDateFilterChanged(null);

    private async Task NextPage()
    {
        _page++;
        await LoadGamesAsync();
    }

    private async Task PreviousPage()
    {
        if (_page == 0) return;
        _page--;
        await LoadGamesAsync();
    }

    private async Task OnRowClick(TableRowClickEventArgs<GameSummary> args)
    {
        if (args.Item is null) return;

        var parameters = new DialogParameters<BoxScoreDialogue> { { x => x.GameId, args.Item.GameId } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<BoxScoreDialogue>(args.Item.Matchup, parameters, options);
    }
}
